  <!-- ============ THE LOOP (signature: flowing orbital diagram) ============ -->
  <section class="loop" id="loop">
    <div class="container">
      <header class="sec-head reveal">
        <span class="eyebrow">The loop</span>
        <h2 class="sec-h2">From zero to ten platforms. <span class="grad-text">Autonomously.</span></h2>
      </header>

      <div class="loop__stage reveal" id="loopStage">
        <!-- flowing luminous path -->
        <svg class="loop__path" viewBox="0 0 1000 420" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <defs>
            <linearGradient id="flowGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#2dd4bf" />
              <stop offset="50%" stop-color="#6366f1" />
              <stop offset="100%" stop-color="#d946ef" />
            </linearGradient>
            <filter id="soft" x="-30%" y="-30%" width="160%" height="160%">
              <feGaussianBlur stdDeviation="3" />
            </filter>
          </defs>
          <path id="loopCurve" class="loop__curve"
            d="M 90 210 C 250 60, 360 60, 500 210 S 760 360, 910 210"
            fill="none" stroke="url(#flowGrad)" stroke-width="2.5" filter="url(#soft)" />
          <path class="loop__curve loop__curve--dim"
            d="M 90 210 C 250 60, 360 60, 500 210 S 760 360, 910 210"
            fill="none" stroke="rgba(255,255,255,.08)" stroke-width="1.5" />
          <circle class="loop__pulse" id="loopPulse" r="6" fill="#eef1ff" />
        </svg>

        <!-- inputs cluster (left) -->
        <div class="loop__inputs" aria-label="Inputs">
          <span class="orb orb--sm" data-orb>Idea</span>
          <span class="orb orb--sm" data-orb>Blog</span>
          <span class="orb orb--sm" data-orb>Script</span>
          <span class="orb orb--sm" data-orb>Audio</span>
          <span class="orb orb--sm" data-orb>Video</span>
          <span class="orb orb--sm" data-orb>URL</span>
        </div>

        <!-- engine (center orb) -->
        <div class="loop__engine">
          <div class="engine-orb glass" data-orb>
            <span class="engine-orb__ratio"><b>95%</b> AI / <b>5%</b> you</span>
            <span class="engine-orb__label">script → scenes → video</span>
          </div>
        </div>

        <!-- output depths (right) -->
        <div class="loop__outputs" aria-label="Output depths">
          <span class="orb orb--depth" data-orb>Script text</span>
          <span class="orb orb--depth" data-orb>Scenes</span>
          <span class="orb orb--depth" data-orb>Finished video</span>
        </div>
      </div>

      <!-- 10 platform chips that bloom when the pulse reaches them -->
      <!-- PLACEHOLDER: 10 distribution platforms — illustrative -->
      <div class="loop__platforms reveal" id="loopPlatforms" aria-label="Distribution platforms">
        <span class="chip glass" data-platform>TikTok</span>
        <span class="chip glass" data-platform>YouTube</span>
        <span class="chip glass" data-platform>Instagram</span>
        <span class="chip glass" data-platform>Facebook</span>
        <span class="chip glass" data-platform>X</span>
        <span class="chip glass" data-platform>LinkedIn</span>
        <span class="chip glass" data-platform>Threads</span>
        <span class="chip glass" data-platform>Pinterest</span>
        <span class="chip glass" data-platform>Reddit</span>
        <span class="chip glass" data-platform>Snapchat</span>
      </div>
    </div>
  </section>

  <!-- ============ INPUTS ============ -->
  <section class="inputs" id="inputs">
    <div class="container">
      <header class="sec-head reveal">
        <span class="eyebrow">Inputs</span>
        <h2 class="sec-h2">Feed it whatever your agent already has.</h2>
      </header>
      <div class="grid grid--3">
        <article class="card glass reveal">
          <span class="card__badge badge--live">Live</span>
          <h3>From a script</h3>
          <p>Hand WideCast finished copy and it builds scenes straight from your words.</p>
          <code class="card__api">source: "script" · POST /v1/create_video</code>
        </article>
        <article class="card glass reveal" data-reveal-delay="60">
          <span class="card__badge badge--live">Live</span>
          <h3>From an idea</h3>
          <p>Give it a one-line idea and it writes the script, then the scenes.</p>
          <code class="card__api">source: "idea"</code>
        </article>
        <article class="card glass reveal" data-reveal-delay="120">
          <span class="card__badge badge--live">Live</span>
          <h3>From a blog or article</h3>
          <p>Drop in long-form writing and it distills a punchy short-form cut.</p>
          <code class="card__api">source: "blog"</code>
        </article>
        <article class="card glass reveal">
          <span class="card__badge badge--next">Next</span>
          <h3>From audio</h3>
          <p>Turn a podcast or voice memo into captioned, scene-cut video.</p>
          <code class="card__api">source: "audio"</code>
        </article>
        <article class="card glass reveal" data-reveal-delay="60">
          <span class="card__badge badge--next">Next</span>
          <h3>Remake a video</h3>
          <p>Repurpose an existing clip into fresh cuts for every platform.</p>
          <code class="card__api">source: "video"</code>
        </article>
        <article class="card glass reveal" data-reveal-delay="120">
          <span class="card__badge badge--next">Next</span>
          <h3>From any URL</h3>
          <p>Point it at a link and it pulls the story, then produces the video.</p>
          <code class="card__api">source: "url"</code>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ HUMAN-IN-THE-LOOP ============ -->
  <section class="human" id="human">
    <div class="container human__grid">
      <div class="human__copy reveal">
        <span class="eyebrow">Human-in-the-loop</span>
        <h2 class="sec-h2">The 5% that separates agency work from <span class="grad-text">AI slop.</span></h2>
        <p class="lead">Hand a <code>review_url</code> to a human who previews and edits every scene before export. The agent stays in control of the pipeline; a person guards the quality bar.</p>
        <ul class="check">
          <li>Preview &amp; edit every scene before render</li>
          <li>Approve script · approve scenes · retry</li>
          <li>Skip review entirely with <code>output_type="video"</code></li>
          <li>Same <code>GET /v1/status/{id}</code> envelope throughout</li>
        </ul>

        <!-- 95/5 ratio motif -->
        <div class="ratio glass reveal" aria-label="95 percent AI, 5 percent you">
          <div class="ratio__bar">
            <span class="ratio__ai" style="--w:95%"><b>95%</b> AI</span>
            <span class="ratio__you" style="--w:5%"><b>5%</b> you</span>
          </div>
        </div>
      </div>

      <!-- mock scene editor / review UI -->
      <div class="human__editor reveal" data-reveal-delay="120">
        <div class="editor glass glow-border">
          <div class="editor__bar">
            <span class="editor__title">scene review</span>
            <span class="editor__url">/review/8f2a…</span>
          </div>
          <div class="editor__scenes">
            <div class="scene scene--ok">
              <span class="scene__tag">HOOK</span>
              <span class="scene__thumb"></span>
              <span class="scene__state">approved</span>
            </div>
            <div class="scene scene--editing">
              <span class="scene__tag">BODY</span>
              <span class="scene__thumb scene__thumb--edit"></span>
              <span class="scene__state">editing…</span>
            </div>
            <div class="scene scene--ok">
              <span class="scene__tag">BODY</span>
              <span class="scene__thumb"></span>
              <span class="scene__state">approved</span>
            </div>
            <div class="scene scene--ok">
              <span class="scene__tag">CTA</span>
              <span class="scene__thumb"></span>
              <span class="scene__state">approved</span>
            </div>
          </div>
          <div class="editor__actions">
            <button class="btn btn--sm btn--ghost" data-inert>Retry</button>
            <button class="btn btn--sm btn--ghost" data-inert>Approve script</button>
            <button class="btn btn--sm btn--primary" data-inert>Approve &amp; export</button>
          </div>
        </div>
      </div>
    </div>
  </section>

