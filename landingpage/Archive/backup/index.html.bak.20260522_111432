  <!-- ============ QUICKSTART CODE ============ -->
  <section class="quickstart" id="quickstart">
    <div class="container">
      <header class="sec-head reveal">
        <span class="eyebrow">Quickstart</span>
        <h2 class="sec-h2">Hello, video — <span class="grad-text">from your agent.</span></h2>
      </header>
      <div class="code glass glow-border reveal">
        <div class="code__tabs" role="tablist" aria-label="Language">
          <button class="code__tab is-active" role="tab" aria-selected="true" data-code="py">Python</button>
          <button class="code__tab" role="tab" aria-selected="false" data-code="ts">TypeScript</button>
          <button class="code__tab" role="tab" aria-selected="false" data-code="mcp">MCP tool call</button>
          <button class="code__tab" role="tab" aria-selected="false" data-code="curl">cURL</button>
          <button class="copy-btn copy-btn--code" data-copy-target=".code__panel.is-active code" aria-label="Copy code">Copy</button>
        </div>
        <div class="code__body">
<pre class="code__panel is-active" data-code-panel="py"><code>from widecast import WideCast

wc = WideCast(api_key="wc_live_REPLACE_ME")

job = wc.create_video(
    source="idea",
    idea_text="why founders should ship on day one",
    output_type="video",
)

status = wc.status(job.id)   # poll /v1/status/{id}
print(status.state, status.review_url)</code></pre>
<pre class="code__panel" data-code-panel="ts"><code>import { WideCast } from "@widecast/sdk";

const wc = new WideCast({ apiKey: "wc_live_REPLACE_ME" });

const job = await wc.createVideo({
  source: "idea",
  ideaText: "why founders should ship on day one",
  outputType: "video",
});

const status = await wc.status(job.id); // poll /v1/status/{id}
console.log(status.state, status.reviewUrl);</code></pre>
<pre class="code__panel" data-code-panel="mcp"><code>{
  "tool": "widecast.create_video",
  "arguments": {
    "source": "idea",
    "idea_text": "why founders should ship on day one",
    "output_type": "video"
  }
}
// then: widecast.status { "id": "&lt;job_id&gt;" }</code></pre>
<pre class="code__panel" data-code-panel="curl"><code>curl -X POST https://api.widecast.ai/v1/create_video \
  -H "Authorization: Bearer wc_live_REPLACE_ME" \
  -H "Content-Type: application/json" \
  -d '{
    "source": "idea",
    "idea_text": "why founders should ship on day one",
    "output_type": "video"
  }'

# poll
curl https://api.widecast.ai/v1/status/$JOB_ID \
  -H "Authorization: Bearer wc_live_REPLACE_ME"</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BUILT FOR AGENTS ============ -->
  <section class="agents" id="built">
    <div class="container">
      <header class="sec-head reveal">
        <span class="eyebrow">Built for agents</span>
        <h2 class="sec-h2">Agent-native, <span class="grad-text">not bolted on.</span></h2>
      </header>
      <div class="grid grid--4">
        <article class="feat glass reveal">
          <h3>One spec, self-describing</h3>
          <p>OpenAPI 3.1 + JSON Schema agents generate tools from <code>/openapi.json</code>.</p>
        </article>
        <article class="feat glass reveal" data-reveal-delay="60">
          <h3>Async by default</h3>
          <p>POST then poll <code>/v1/status/{id}</code> or receive an HMAC webhook.</p>
        </article>
        <article class="feat glass reveal" data-reveal-delay="120">
          <h3>Errors agents can act on</h3>
          <p>Structured error envelope: <code>type / code / doc_url / request_id</code>.</p>
        </article>
        <article class="feat glass reveal" data-reveal-delay="180">
          <h3>Idempotent &amp; safe to retry</h3>
          <p><code>Idempotency-Key</code> dedupe — retry without double-spending.</p>
        </article>
      </div>
    </div>
  </section>

