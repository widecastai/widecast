<main id="top">

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy reveal">
        <span class="eyebrow">Content production &amp; distribution layer for AI agents</span>
        <h1 class="hero__h1">Give your AI agent a <span class="grad-text">media team.</span></h1>
        <p class="lead">WideCast is the production &amp; distribution layer for AI agents. One install — your agent goes from a raw idea to published across 10 platforms. <strong>95% AI, 5% you.</strong></p>

        <!-- install block: tabbed copy commands -->
        <div class="install glass">
          <div class="install__tabs" role="tablist" aria-label="Install method">
            <button class="install__tab is-active" role="tab" aria-selected="true" data-install="mcp">MCP</button>
            <button class="install__tab" role="tab" aria-selected="false" data-install="py">Python</button>
            <button class="install__tab" role="tab" aria-selected="false" data-install="node">Node</button>
            <button class="install__tab" role="tab" aria-selected="false" data-install="skill">Claude Skill</button>
          </div>
          <div class="install__body">
            <pre class="install__cmd is-active" data-install-panel="mcp"><span class="prompt">$</span> <code>claude mcp add widecast widecast-mcp --env WIDECAST_API_KEY=wc_live_REPLACE_ME</code></pre>
            <pre class="install__cmd" data-install-panel="py"><span class="prompt">$</span> <code>pip install widecast</code></pre>
            <pre class="install__cmd" data-install-panel="node"><span class="prompt">$</span> <code>npm i @widecast/sdk</code></pre>
            <pre class="install__cmd" data-install-panel="skill"><span class="prompt">$</span> <code>npx @widecast/skill add</code></pre>
            <button class="copy-btn" data-copy-target=".install__cmd.is-active code" aria-label="Copy command">Copy</button>
          </div>
        </div>

        <div class="hero__btns">
          <a href="#demos" class="btn btn--primary">See an agent do it <span aria-hidden="true">→</span></a>
          <a href="#" class="btn btn--ghost" data-inert>Read the docs</a>
        </div>
      </div>

      <!-- Hero agent transcript glass card -->
      <!-- PLACEHOLDER: illustrative agent transcript — demo content, not a live session -->
      <div class="hero__agent reveal" data-reveal-delay="120">
        <div class="agent-card glass glow-border">
          <div class="agent-card__bar">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="agent-card__title">agent · session</span>
          </div>
