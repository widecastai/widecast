              <span class="msg__who">user</span>
              <span class="msg__txt">make a short video about our launch and post it everywhere</span>
            </div>
            <div class="msg msg--tool" data-line>
              <span class="msg__who">tool</span>
              <span class="msg__txt"><code>widecast.create_video()</code></span>
            </div>
            <div class="msg msg--sys" data-line>
              <span class="msg__bar"><i style="--w:95%"></i></span>
              <span class="msg__txt">writing script <em class="tag tag--ai">95% AI</em></span>
            </div>
            <div class="msg msg--sys" data-line>
              <span class="msg__txt">scenes ready <em class="tag">4 scenes</em></span>
            </div>
            <div class="msg msg--sys" data-line>
              <span class="msg__bar"><i style="--w:5%"></i></span>
              <span class="msg__txt">human review <em class="tag tag--you">5% you</em></span>
            </div>
            <div class="msg msg--sys" data-line>
              <span class="msg__txt">approved — rendering <span class="spin" aria-hidden="true"></span></span>
            </div>
            <div class="msg msg--done" data-line>
              <span class="msg__who">published</span>
              <span class="msg__txt">TikTok · YouTube · IG · X · <strong>+6</strong></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BAND ============ -->
  <section class="band reveal">
    <div class="container">
      <p class="band__label">Built for the agents your developers ship</p>
      <ul class="band__logos">
