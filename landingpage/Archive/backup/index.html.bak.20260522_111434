<!-- ===================== QUICKSTART CODE ===================== -->
<section class="quickstart" id="quickstart">
  <div class="wrap">
    <header class="sec-head reveal">
      <p class="sec-eyebrow tc-mono">REEL 06 · QUICKSTART</p>
      <h2 class="sec-h2">Hello, video — from your agent.</h2>
    </header>

    <div class="code-block reveal">
      <div class="code-tabs" role="tablist" aria-label="Code example language">
        <button class="code-tab is-active" role="tab" aria-selected="true" data-code="py">Python</button>
        <button class="code-tab" role="tab" aria-selected="false" data-code="ts">TypeScript</button>
        <button class="code-tab" role="tab" aria-selected="false" data-code="mcp">MCP tool call</button>
        <button class="code-tab" role="tab" aria-selected="false" data-code="curl">cURL</button>
        <button class="copy-btn code-copy" data-copy-target=".code-pane.is-active code" aria-label="Copy code">Copy</button>
      </div>
      <pre class="code-pane is-active" data-code-body="py"><code>from widecast import WideCast

wc = WideCast(api_key="wc_live_REPLACE_ME")

job = wc.create_video(
    source="idea",
    idea_text="why founders should ship on day one",
    output_type="video",
)

while True:
    status = wc.status(job.id)        # GET /v1/status/{id}
    if status.state == "published":
        print(status.platforms)
        break</code></pre>
      <pre class="code-pane" data-code-body="ts"><code>import { WideCast } from "@widecast/sdk";

const wc = new WideCast({ apiKey: "wc_live_REPLACE_ME" });

const job = await wc.createVideo({
  source: "idea",
  idea_text: "why founders should ship on day one",
  output_type: "video",
});

let status = await wc.status(job.id);   // GET /v1/status/{id}
while (status.state !== "published") {
  status = await wc.status(job.id);
}
console.log(status.platforms);</code></pre>
      <pre class="code-pane" data-code-body="mcp"><code>// MCP tool call from your agent
{
  "tool": "widecast.create_video",
  "arguments": {
    "source": "idea",
    "idea_text": "why founders should ship on day one",
    "output_type": "video"
  }
}
// then poll widecast.status { "id": "<job_id>" }</code></pre>
      <pre class="code-pane" data-code-body="curl"><code>curl -X POST https://api.widecast.ai/v1/create_video \
  -H "Authorization: Bearer wc_live_REPLACE_ME" \
  -H "Content-Type: application/json" \
  -d '{
    "source": "idea",
    "idea_text": "why founders should ship on day one",
    "output_type": "video"
  }'

# then: curl https://api.widecast.ai/v1/status/{id}</code></pre>
    </div>
  </div>
</section>

