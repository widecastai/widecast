      "type": "text",
      "label": "sub_industry (optional)",
      "required": false
    },
    {
      "name": "page",
      "type": "text",
      "label": "page",
      "required": false,
      "placeholder": "0"
    }
  ],
  "poll_after_create": {
    "enabled": false
  },
  "use_cases": [
    {
      "id": "foundation",
      "title": "🏛️ Foundation templates",
      "description": "Browse foundation templates for an industry.",
      "request": {
        "industry": "Real Estate",
        "page": 0
      }
    }
  ],
  "_key": "foundation-videos",
  "_api_base_url": "https://widecast.ai/app/dashboard2"
}