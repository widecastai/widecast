{
  "endpoint": {
    "method": "GET",
    "path": "/v1/foundation_videos"
  },
  "title": "Foundation video templates",
  "description": "Read-only, free. The curated foundation-video template library. `industry`\nfalls back to your account industry.\n",
  "fields": [
    {
      "name": "industry",
      "type": "text",
      "label": "industry (optional)",
      "required": false,
      "placeholder": "Real Estate"
    },
    {
