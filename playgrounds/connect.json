          "label": "Instagram"
        },
        {
          "value": "facebook",
          "label": "Facebook"
        },
        {
          "value": "linkedin",
          "label": "LinkedIn"
        },
        {
          "value": "x",
          "label": "X (Twitter)"
        },
        {
          "value": "threads",
          "label": "Threads"
        },
        {
          "value": "pinterest",
          "label": "Pinterest"
        },
        {
          "value": "reddit",
          "label": "Reddit"
        },
        {
          "value": "bluesky",
          "label": "Bluesky"
